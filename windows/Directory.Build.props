<Project>
  <!-- The one version number. The SDK derives Version, AssemblyVersion and FileVersion (1.0.0.0) and
       InformationalVersion from it; the exe's file properties, the Settings footer and the tray read it.
       A release build can override it with -p:Version=1.0.1. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>SimDeck Companion</Product>
    <Company>SimDeck</Company>
    <Copyright>SimDeck</Copyright>
  </PropertyGroup>
  <!-- Published builds carry their symbols inside the exe, so the release folder is just SimDeckCompanion.exe. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
